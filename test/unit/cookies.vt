# cookies ('|' = blank)
setcookie http://www.example.com/a/b/page.html sid=123
cookies http://www.example.com/a/b/other
cookies http://www.example.com/a/x
cookies http://example.com/a/b/x
setcookie http://www.example.com/ lang=sv;|Path=/;|Domain=.example.com
cookies http://shop.example.com/
cookies http://www.example.com/a/b/c
cookies http://example.com.evil.org/
setcookie http://www.example.com/ evil=1;|Domain=other.com
cookies http://other.com/
setcookie https://secure.example.com/ token=abc;|Secure;|Path=/
cookies http://secure.example.com/
cookies https://secure.example.com/
setcookie http://www.example.com/ lang=en;|Path=/;|Domain=example.com
cookies http://www.example.com/
setcookie http://www.example.com/ lang=;|Path=/;|Domain=example.com;|Max-Age=0
cookies http://www.example.com/
setcookie http://www.example.com/a/b/page.html sid=;|expires=Thu,|01|Jan|1970|00:00:00|GMT
cookies http://www.example.com/a/b/other
setcookie http://h/ =bad
setcookie http://h/ novalue
cookies http://h/
# expiry: Max-Age, Expires in the past (not stored) and future, 2 digit years
setcookie http://p.example/ keep=1;|Max-Age=3600
setcookie http://p.example/ old=1;|Expires=Wed,|01|Jan|2020|00:00:00|GMT
setcookie http://p.example/ far=1;|expires=Mon,|01-Jan-2060|00:00:00|GMT
setcookie http://p.example/ two=1;|expires=Thursday,|01-Jan-70|00:00:00|GMT
setcookie http://p.example/ age=1;|Max-Age=0;|Expires=Mon,|01|Jan|2060|00:00:00|GMT
cookies http://p.example/
