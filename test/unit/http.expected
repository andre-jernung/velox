# HttpReadResponse on canned responses (generated by mkhttp.py)
http build/http/length.txt => status=200 length=11 chunked=0 type=[text/html; charset=utf-8] location=[] body=11
<<<hello world>>>
http build/http/chunked.txt => status=200 length=-1 chunked=1 type=[] location=[] body=12
<<<hello, world>>>
http build/http/redirect.txt => status=301 length=0 chunked=0 type=[] location=[/new/place?a=1] body=0
<<<>>>
http build/http/eof.txt => status=200 length=-1 chunked=0 type=[text/plain] location=[] body=12
<<<line1
line2
>>>
http build/http/continue.txt => status=404 length=3 chunked=0 type=[] location=[] body=3
<<<nop>>>
http build/http/notmodified.txt => status=304 length=99 chunked=0 type=[] location=[] body=0
<<<>>>
http build/http/lfonly.txt => status=200 length=2 chunked=0 type=[] location=[] body=2
<<<hi>>>
http build/http/short.txt => status=200 length=100 chunked=0 type=[] location=[] body=9
<<<only this>>>
http build/http/garbage.txt => ERROR Invalid HTTP response
http build/http/empty.txt => ERROR Invalid HTTP response
# 40000 byte bodies crossing the 4 KB connection buffer
httpinfo build/http/biglength.txt => status=200 length=40000 chunked=0 type=[] location=[] body=40000 sum=1202888132
httpinfo build/http/bigchunked.txt => status=200 length=-1 chunked=1 type=[] location=[] body=40000 sum=1202888132
