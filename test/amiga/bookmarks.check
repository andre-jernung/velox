#!/usr/bin/env python3
"""checks for bookmarks.script"""
import os
import sys

r = sys.argv[1]
d = os.path.dirname(r)
drv = open(os.path.join(d, "bookmarks.driver")).read()
print("".join("driver: " + l + "\n" for l in drv.splitlines()), end="")
fail = "ok" not in drv.splitlines()
p = os.path.join(d, "Bookmarks.html")
bm = open(p, encoding="latin-1").read() if os.path.exists(p) else ""
for want in ('<a href="file:///RAM:local.html">Local &amp; file</a>',
             '<a href="file:///RAM:second.html">Second local</a>',
             "<h1>Bookmarks</h1>"):
    if want not in bm:
        print("Bookmarks.html lacks", want)
        fail = True
if bm.count("<li>") != 2:
    print("expected 2 bookmarks, got", bm.count("<li>"))
    fail = True
if bm.count("<h1>") != 1:
    print("header written more than once")
    fail = True
sys.exit(1 if fail else 0)
