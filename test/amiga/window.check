#!/bin/sh
# checks for window.script; $1 = result file
r=$1; fail=0
grep -q '^running: yes' "$r" || { echo "velox was not running"; fail=1; }
grep -q '^after_break: exited' "$r" || { echo "velox did not exit on Ctrl-C"; fail=1; }
before=$(sed -n 's/^mem_before *//p' "$r" | tr -dc 0-9)
after=$(sed -n 's/^mem_after *//p' "$r" | tr -dc 0-9)
echo "memory: before=$before after=$after"
# three runs are measured.  The system itself sometimes keeps a few
# bytes (seen: 24) between measurements; a leak in Velox would repeat
# with every run, so up to 32 bytes in total are taken as noise.
[ -n "$before" ] && [ -n "$after" ] && [ $((before - after)) -le 32 ] || { echo "memory not fully returned"; fail=1; }
# the window position and size are kept for the next run
g=$(cat "$(dirname "$r")/window.geom" 2>/dev/null)
echo "geometry: $g"
echo "$g" | grep -qE '^[0-9]+ [0-9]+ [0-9]+ [0-9]+$' || { echo "Velox/Window not saved"; fail=1; }
exit $fail
