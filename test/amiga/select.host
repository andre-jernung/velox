#!/usr/bin/env python3
"""Host side of select.script: drag from the start of the heading to the
end of the next line; the Amiga runs the mouse commands written here."""
import os
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
from xdrive import wait_log  # noqa: E402

r = sys.argv[1]
log = os.path.join(r, "select.log")
out = open(os.path.join(r, "select.driver"), "w")
try:
    lines = wait_log(log, "page http://127.0.0.1:8080/second.html")
    x = int([l for l in lines if l.startswith("pagex ")][-1].split()[1])
    y = int([l for l in lines if l.startswith("pagey ")][-1].split()[1])
    time.sleep(1)
    # the heading is the first line of the page (h2, below its margin);
    # the paragraph "Back to the index." follows
    cmds = [
        "VELOX:mouse %d %d" % (x + 9, y + 18),
        "VELOX:mouse %d %d DOWN" % (x + 9, y + 18),
        "Wait 1",
    ]
    for dy in range(20, 42, 4):
        cmds.append("VELOX:mouse %d %d DRAG" % (x + 200, y + dy))
    cmds += ["VELOX:mouse %d %d UP" % (x + 400, y + 42), "Wait 1",
             "Echo >VELOX:shot.req \"\"", "Wait 4"]
    with open(os.path.join(r, "select.go.tmp"), "w") as f:
        f.write("\n".join(cmds) + "\n")
    os.rename(os.path.join(r, "select.go.tmp"), os.path.join(r, "select.go"))
    wait_log(log, "selected ", timeout=60)
    out.write("selected\nok\n")
except Exception as e:
    out.write("FAIL %r\n" % e)
