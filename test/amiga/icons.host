#!/usr/bin/env python3
"""Host side of icons.script: 24 images, 4 different ones (test.png,
test.gif at width 32, test.png at width 32, test.webp): all 24 shown,
4 decoded."""
import os
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
from xdrive import Amiga, wait_log  # noqa: E402

r = sys.argv[1]
log = os.path.join(r, "icons.log")
out = open(os.path.join(r, "icons.driver"), "w")
try:
    a = Amiga()
    lines = wait_log(log, "images ", timeout=120)
    shown = [l for l in lines if l.startswith("images ")][-1].split()[1]
    decoded = len([l for l in lines if l.startswith("imgtime ")])
    out.write("shown %s, decoded %d\n" % (shown, decoded))
    if shown != "24" or decoded != 4:
        raise AssertionError("expected 24 shown, 4 decoded")
    time.sleep(2)
    a.shot(os.path.join(r, "icons.png"))
    # on the screen too (not their alt texts): the pictures are mostly
    # black (PIL is in the system's Python, not in tools/venv)
    import subprocess
    dark = int(subprocess.run(["/usr/bin/python3", "-I", "-c", """
import sys
from PIL import Image
im = Image.open(sys.argv[1]).convert("RGB")
print(sum(1 for x in range(130, 810, 2) for y in range(190, 530, 2)
          if sum(im.getpixel((x, y))) < 90))
""", os.path.join(r, "icons.png")], capture_output=True, text=True, check=True).stdout)
    out.write("dark pixels: %d\n" % dark)
    if dark < 5000:
        raise AssertionError("the images are not on the screen")
    a.key("ctrl+q")
    out.write("ok\n")
except Exception as e:
    out.write("FAIL %r\n" % e)
    try:
        Amiga().key("ctrl+q")
    except Exception:
        pass
