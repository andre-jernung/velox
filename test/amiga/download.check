#!/usr/bin/env python3
"""checks for download.script"""
import os
import sys

r = sys.argv[1]
d = os.path.dirname(r)
drv = open(os.path.join(d, "download.driver")).read()
print("".join("driver: " + l + "\n" for l in drv.splitlines()), end="")
fail = "ok" not in drv.splitlines()
big = bytes((i * 7 + 13) % 251 for i in range(100000))
p = os.path.join(d, "big")
if not os.path.exists(p) or open(p, "rb").read() != big:
    print("saved file differs:", os.path.getsize(p) if os.path.exists(p) else "missing")
    fail = True
sys.exit(1 if fail else 0)
