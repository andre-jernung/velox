#!/usr/bin/env python3
"""checks for clip.script: the clipboard holds an IFF FTXT with the URL"""
import os
import struct
import sys

r = sys.argv[1]
d = os.path.dirname(r)
drv = open(os.path.join(d, "clip.driver")).read()
print("".join("driver: " + l + "\n" for l in drv.splitlines()), end="")
fail = "ok" not in drv.splitlines()
p = os.path.join(d, "clip.iff")
data = open(p, "rb").read() if os.path.exists(p) else b""
want = b"http://127.0.0.1:8080/index.html"
ok = (len(data) >= 20 and data[:4] == b"FORM" and data[8:16] == b"FTXTCHRS"
      and struct.unpack(">I", data[4:8])[0] == len(data) - 8
      and data[20:20 + struct.unpack(">I", data[16:20])[0]] == want)
print("clipboard:", data[:64])
if not ok:
    print("clipboard does not hold", want)
    fail = True
sys.exit(1 if fail else 0)
