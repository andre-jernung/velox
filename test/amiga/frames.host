#!/usr/bin/env python3
"""Host side of frames.script: a meta refresh moves on by itself (and is
not kept in the history); a frameset shows its frames' documents (a
nested one too, one of height 0 hidden), their relative URLs taken
against their own; the
keys scroll the active frame alone, and so does a click in its own
scrollbar; Tab goes on into the next frame; a link
targeting a frame (by <base target>) replaces that frame's document,
Back brings the one before; a link with target=_top leaves the
frames."""
import os
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
from xdrive import Amiga, wait_log  # noqa: E402

r = sys.argv[1]
log = os.path.join(r, "frames.log")
out = open(os.path.join(r, "frames.driver"), "w")
U = "http://127.0.0.1:8080/"
F = U + "fr/"


def step(msg):
    out.write(msg + "\n")
    out.flush()


def lines():
    return open(log, "rb").read().decode("latin-1").split("\n")


def count(prefix):
    return len([x for x in lines() if x.startswith(prefix)])


CLICKS = [0]


def click(sx, sy):
    """a click at screen position sx/sy (the Amiga runs frames.goN)"""
    CLICKS[0] += 1
    with open(os.path.join(r, "frames.go%d" % CLICKS[0]), "w") as f:
        f.write("VELOX:mouse %d %d\nWait 1\nVELOX:mouse %d %d DOWN\n"
                "VELOX:mouse %d %d UP\n" % (sx, sy, sx, sy, sx, sy))
    time.sleep(3)


def rects():
    """the frames shown: {N: (x, y, w, h)} (window), and the window's
    origin on the screen"""
    fr = {}
    for x in lines():
        p = x.split()
        if p and p[0] == "frect":
            fr[int(p[5])] = tuple(int(v) for v in p[1:5])
    ls = lines()
    px = int([l for l in ls if l.startswith("pagex ")][-1].split()[1])
    py = int([l for l in ls if l.startswith("pagey ")][-1].split()[1])
    return fr, px - fr[1][0], py - fr[1][1]


def go(a, url):
    a.key("ctrl+l"); a.key("amiga+x")
    a.type(url)
    a.key("Return")


try:
    a = Amiga()
    wait_log(log, "page " + U + "index.html")
    time.sleep(1)
    go(a, "127.0.0.1:8080/refresh.html")
    wait_log(log, "page " + U + "refresh.html")
    wait_log(log, "page " + U + "second.html", timeout=20)
    step("meta refresh went on to the target")
    a.key("BackSpace")
    wait_log(log, "page " + U + "index.html", 2)
    step("back skips the refresh page")

    # a frameset: its frames' documents in the page
    go(a, "127.0.0.1:8080/fr/top.html")
    wait_log(log, "page " + F + "top.html", timeout=60)
    frames = [x for x in lines() if x.startswith("frame ")]
    if frames != ["frame nav", "frame head", "frame main", "frame hid"]:
        raise AssertionError("frames: %r" % frames)
    step("a frameset shows its frames (a nested one too)")
    wait_log(log, "images ", timeout=60)
    imgs = [x for x in lines() if x.startswith("images ")][-1]
    if imgs != "images 1":
        raise AssertionError("the picture in a frame: %r" % imgs)
    step("a picture in a frame: its URL against the frame's")
    if not count("frames 3"):          # (the 4th, of height 0: hidden)
        raise AssertionError("not 3 frames: %r" % [x for x in lines() if x.startswith("frames ")])
    time.sleep(1)
    a.shot(os.path.join(r, "frames.png"))

    # the keys scroll the active frame (the largest: main, the 3rd) alone
    for i in range(3):
        n = count("fscroll ")
        a.key("Down")
        wait_log(log, "fscroll ", n + 1, timeout=10)
    fs = [x for x in lines() if x.startswith("fscroll ")]
    if set(fs) != {"fscroll 3"}:
        raise AssertionError("frames scrolled: %r" % fs)
    step("a frame scrolls on its own")
    time.sleep(1)
    a.shot(os.path.join(r, "frames1.png"))

    # its own scrollbar: a click below the knob, a page further; the
    # navigation frame's (it all fits: no knob) does nothing
    fr, ox, oy = rects()
    x, y, w, h = fr[3]
    sc = [int(l.split()[1]) for l in lines() if l.startswith("scroll ")]
    n = count("fscroll ")
    click(ox + x + w - 6, oy + y + h - 6)
    wait_log(log, "fscroll ", n + 1, timeout=10)
    sc2 = [int(l.split()[1]) for l in lines() if l.startswith("scroll ")]
    if lines() and [l for l in lines() if l.startswith("fscroll ")][-1] != "fscroll 3" or sc2[-1] <= sc[-1] + 50:
        raise AssertionError("its scrollbar: %r -> %r" % (sc[-1:], sc2[-1:]))
    x, y, w, h = fr[1]
    n = count("fscroll ")
    click(ox + x + w - 6, oy + y + h - 6)
    if count("fscroll ") != n:
        raise AssertionError("a scrollbar with nothing to scroll scrolled")
    step("a frame's own scrollbar: a page further (%d -> %d)" % (sc[-1], sc2[-1]))
    a.shot(os.path.join(r, "frames1b.png"))

    # Tab: past the active frame's links (none), on in the next frame;
    # <base target="main">: the link replaces the main frame's document
    a.key("Tab")
    wait_log(log, "focus " + F + "page2.html")
    n = count("page " + F + "top.html ")     # (not with frames' URLs)
    nf, nl = count("frame "), count("layout ")
    a.key("Return")
    want = "page " + F + "top.html\x01main\x02" + F + "page2.html"
    wait_log(log, want, timeout=60)
    step("a link targeting a frame replaces its document")
    fr = [x for x in lines() if x.startswith("frame ")][nf:]
    if fr != ["frame main"] or count("layout ") - nl != 1:
        raise AssertionError("loaded %r, laid out %d" % (fr, count("layout ") - nl))
    step("that frame alone is loaded and laid out again")
    time.sleep(1)
    a.shot(os.path.join(r, "frames2.png"))

    # Back: the frames as they were, the same way
    nf = count("frame ")
    a.key("BackSpace")
    wait_log(log, "page " + F + "top.html ", n + 1, timeout=60)
    fr = [x for x in lines() if x.startswith("frame ")][nf:]
    if fr != ["frame main"]:
        raise AssertionError("back loaded %r" % fr)
    step("back brings the frame's document before, alone")
    time.sleep(1)

    # target=_top: out of the frames
    for i in range(8):          # (the focus is where it was: Tab on)
        a.key("Tab")
        time.sleep(0.5)
        if count("focus " + U + "second.html"):
            break
    wait_log(log, "focus " + U + "second.html")
    a.key("Return")
    wait_log(log, "page " + U + "second.html", 2, timeout=60)
    step("target=_top leaves the frames")

    # onclick="target='main';" (no target attribute, no <base target>):
    # the same as target="main", for a link and a form; an onclick doing
    # more than that is a script, not read: its link stays in its frame
    J = F + "js.html"
    go(a, J)
    wait_log(log, "page " + J, timeout=60)
    time.sleep(1)
    for i in range(8):
        a.key("Tab")
        time.sleep(0.5)
        if count("focus " + F + "page2.html"):
            break
    wait_log(log, "focus " + F + "page2.html")
    a.key("Return")
    wait_log(log, "page " + J + "\x01main\x02" + F + "page2.html", timeout=60)
    step("onclick target='main' sends a link into that frame")
    a.key("Tab")
    wait_log(log, "focus jsgo")
    a.key("Return")
    wait_log(log, "page " + J + "\x01main\x02" + F + "page1.html?q=1", timeout=60)
    step("this.target = \"main\" in a form's onclick: the same")
    a.key("Tab")
    wait_log(log, "focus " + F + "head2.html")
    a.key("Return")
    wait_log(log, "\x01menu\x02" + F + "head2.html", timeout=60)
    step("an onclick doing more: the link stays in its frame")
    a.key("ctrl+q")
    step("ok")
except Exception as e:
    step("FAIL " + repr(e))
    try:
        Amiga().key("ctrl+q")
    except Exception:
        pass
open(os.path.join(r, "frames.end"), "w").close()
