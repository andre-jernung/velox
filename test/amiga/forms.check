#!/bin/sh
# checks for forms.script; $1 = result file
d=$(dirname "$1"); fail=0
sed 's/^/driver: /' "$d/forms.driver"
grep -q '^ok$' "$d/forms.driver" || fail=1
grep -q '^exit rc=0' "$1" || { echo "velox exit code: $(grep exit "$1")"; fail=1; }
body=$(grep 'POST /echo-post body=' "$d/../server.log" | tail -1 | sed 's/^server: \[[0-9]*\] /server: /')
echo "server: $body"
case "$body" in
	*"body=msg=abc&r=2&t=line1%0D%0Aline2") ;;
	*) echo "unexpected POST body"; fail=1 ;;
esac
exit $fail
