; download: save a file that is not a web page (test/amiga/download.host)
Echo >VELOX:r/download.txt "download"
SetEnv Velox/DownloadDir VELOX:r
Echo >VELOX:r/download.start ""
VELOX:velox http://127.0.0.1:8080/big LOG=VELOX:r/download.log
Echo >>VELOX:r/download.txt "exit rc=$RC"
UnSetEnv Velox/DownloadDir
Echo >>VELOX:r/download.txt "done"
