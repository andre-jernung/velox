#!/usr/bin/env python3
"""Host side of images.script: wait for the images, screenshot, quit."""
import os
import subprocess
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
from xdrive import Amiga, wait_log  # noqa: E402

r = sys.argv[1]
log = os.path.join(r, "images.log")
out = open(os.path.join(r, "images.driver"), "w")
try:
    a = Amiga()
    lines = wait_log(log, "images ", timeout=180)
    time.sleep(2)
    a.shot(os.path.join(r, "images.png"))
    out.write([l for l in lines if l.startswith("images ")][-1] + "\n")
    # images repaint only what changed: the page is painted whole once,
    # then the image loads paint less
    # (a repaint cut short for the user, "paint -N", goes on in the next)
    paints, carry = [], 0
    for l in lines:
        if l.startswith("paint "):
            n = int(l.split()[1])
            if n < 0:
                carry -= n
            else:
                paints.append(carry + n)
                carry = 0
    out.write("paints: %s\n" % " ".join(map(str, paints)))
    if len(paints) < 2 or max(paints[1:]) >= paints[0]:
        out.write("FAIL image loads repainted the whole page\n")
    else:
        out.write("image loads repaint only what changed\n")
    out.flush()
    # ... and that leaves the same picture as painting everything: find
    # (highlight), Esc (a full repaint), compare, status line aside
    a.shot(os.path.join(r, "images-inc.png"))
    n = len([l for l in lines if l.startswith("paint ")])
    a.key("/")
    a.type("imag")  # (the heading: in view, no scrolling)
    wait_log(log, "find ", 4)
    a.key("Escape")
    wait_log(log, "paint ", n + 5)
    time.sleep(1.5)
    a.shot(os.path.join(r, "images-full.png"))
    res = subprocess.run(
        ["convert", os.path.join(r, "images-inc.png"),
         os.path.join(r, "images-full.png"), "-compose", "difference",
         "-composite", "-threshold", "0", "-trim", "-format", "%w %h %X %Y",
         "info:"], capture_output=True, text=True)
    out.write("difference: %s\n" % res.stdout.strip())
    w, h = [int(v) for v in res.stdout.split()[:2]]
    # (no difference trims to a 1x1 image; the status line is one row of
    # text, at most 24 pixels high in the screenshot)
    out.write("incremental painting %s\n" % (
        "is exact" if h <= 24 else "differs from a full repaint"))
    out.flush()
    # typing while slow images load: the keys reach the URL field
    a.key("ctrl+l"); a.key("amiga+x")
    a.type("127.0.0.1:8080/slow.html")
    a.key("Return")
    wait_log(log, "page http://127.0.0.1:8080/slow.html")
    time.sleep(1.5)
    a.key("ctrl+l"); a.key("amiga+x")
    a.type("127.0.0.1:8080/second.html")
    t0 = time.time()
    a.key("Return")
    wait_log(log, "page http://127.0.0.1:8080/second.html", timeout=40)
    dt = time.time() - t0
    out.write("typed during image loading: %s\n" % ("in time" if dt < 4 else "late (%.1f s)" % dt))
    a.key("ctrl+q")
    out.write("ok\n")
except Exception as e:
    out.write("FAIL %r\n" % e)
    try:
        Amiga().key("ctrl+q")
    except Exception:
        pass
