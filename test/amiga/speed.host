#!/usr/bin/env python3
"""Host side of speed.script: wait for the images, report the decoding
times (imgtime, in 1/50 s), quit."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
from xdrive import Amiga, wait_log  # noqa: E402

r = sys.argv[1]
log = os.path.join(r, "speed.log")
out = open(os.path.join(r, "speed.driver"), "w")
try:
    a = Amiga()
    lines = wait_log(log, "images ", timeout=1800)
    names = ["baseline JPEG", "progressive JPEG", "PNG", "WebP (lossy)", "GIF",
             "JPEG at 320 (1/2)", "JPEG at 160 (1/4)", "progressive at 160"]
    times = [int(l.split()[1]) for l in lines if l.startswith("imgtime ")]
    conv = [int(l.split()[1]) for l in lines if l.startswith("imgconv ")]
    out.write("%-18s %8s %8s\n" % ("640x480 at 400", "decode", "bitmap"))
    for n, t, c in zip(names, times, conv):
        out.write("%-18s %7.2fs %7.2fs\n" % (n, t / 50.0, c / 50.0))
    # profiling builds (PROFILE=1): the stages of each image, in ms
    stage = {"a": "dither", "b": "WriteChunkyPixels", "c": "JPEG scans",
             "d": "JPEG IDCT", "e": "JPEG colour", "f": "inflate",
             "g": "PNG unfilter", "h": "PNG convert", "i": "VP8 tokens",
             "j": "VP8 reconstruct", "k": "VP8 loop filter",
             "l": "VP8 to RGB", "m": "decoder total"}
    img = 0
    for l in lines:
        if l.startswith("imgconv "):
            img += 1
        if l.startswith("prof"):
            k, v = l[4], l.split()[1]
            out.write("  %s: %-18s %6s ms\n" % (names[img - 1] if img else "?", stage.get(k, k), v))
    a.shot(os.path.join(r, "speed.png"))
    a.key("ctrl+q")
    out.write("ok\n")
except Exception as e:
    out.write("FAIL %r\n" % e)
