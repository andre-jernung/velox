#!/usr/bin/env python3
"""Host side of complete.script: pages visited are offered under the
address field as an address is typed (drop.s, visits.s): Down and
Return go to the one offered (what was typed alone is no page); typed
fast, the text is all there; Esc closes the list.  Ctrl-L keeps the
address shown, unless it is the home page's."""
import os
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
from xdrive import Amiga, wait_log  # noqa: E402

r = sys.argv[1]
log = os.path.join(r, "complete.log")
out = open(os.path.join(r, "complete.driver"), "w")
U = "http://127.0.0.1:8080/"


def step(m):
    out.write(m + "\n")
    out.flush()


def lines():
    with open(log, "rb") as f:
        return f.read().decode("latin-1").splitlines()


def after(n, needle, timeout=30):
    end = time.time() + timeout
    while time.time() < end:
        ls = lines()
        for i in range(n, len(ls)):
            if needle in ls[i]:
                return i
        time.sleep(0.3)
    raise TimeoutError("no %r: %r" % (needle, lines()[n:][-10:]))


try:
    a = Amiga()
    wait_log(log, "page " + U + "index.html")
    for p in ("second.html", "third.html"):   # visited
        n = len(lines())
        a.key("ctrl+l"); a.key("amiga+x")
        a.type(U + p)
        a.key("Return")
        after(n, "page " + U + p)
        time.sleep(1)
    # typed: the list offers second.html; Down, Return: there
    n = len(lines())
    a.key("ctrl+l"); a.key("amiga+x")
    a.type("127.0.0.1:8080/sec")
    j = after(n, "drop ")
    step("offered: " + lines()[j])
    time.sleep(1)
    a.shot(os.path.join(r, "complete.png"))
    a.key("Down")
    a.key("Return")
    after(n, "page " + U + "second.html")
    step("Down, Return: the page offered")
    # typed fast (no pause): all of it there, then the one offered
    n = len(lines())
    a.key("ctrl+l"); a.key("amiga+x")
    a.type("127.0.0.1:8080/thi")
    after(n, "drop 1")
    a.key("Down")
    a.key("Return")
    after(n, "page " + U + "third.html")
    step("typed fast: the page offered")
    # Esc: the list closes
    n = len(lines())
    a.key("ctrl+l"); a.key("amiga+x")
    a.type("127.0.0")
    after(n, "drop ")
    a.key("Escape")
    after(n, "drop 0")
    step("Esc closes it")
    n = len(lines())                    # (then third.html)
    a.key("amiga+x")
    a.type(U + "third.html")
    a.key("Return")
    after(n, "page " + U + "third.html")
    time.sleep(1)
    # Ctrl-L keeps the address shown (the cursor after it) ...
    n = len(lines())
    a.key("ctrl+l")
    a.type("?kept")
    a.key("Return")
    j = after(n, "go ")
    step("Ctrl-L on a page: " + lines()[j])
    if lines()[j] != "go " + U + "third.html?kept":
        raise AssertionError("the address was not kept")
    after(n, "page ")
    time.sleep(1)
    # ... but not the home page's: then it is empty
    n = len(lines())
    a.key("ctrl+h")
    after(n, "page about:velox")
    time.sleep(1)
    n = len(lines())
    a.key("ctrl+l")
    a.type(U + "second.html")
    a.key("Return")
    j = after(n, "go ")
    step("Ctrl-L at home: " + lines()[j])
    if lines()[j] != "go " + U + "second.html":
        raise AssertionError("the home address was not emptied")
    a.key("ctrl+q")
    step("ok")
except Exception as e:
    step("FAIL %r" % e)
    try:
        Amiga().key("Return")           # (out of the address field)
        time.sleep(2)
        Amiga().key("ctrl+q")
    except Exception:
        pass
