#!/usr/bin/env python3
"""Host side of pagespeed.script: big.html (53 KB, 80 CSS rules) fetched,
then again from the disk cache; the stage times (PROFILE=1 builds)."""
import os
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
from xdrive import Amiga, wait_log  # noqa: E402

r = sys.argv[1]
log = os.path.join(r, "pagespeed.log")
out = open(os.path.join(r, "pagespeed.driver"), "w")
U = "http://127.0.0.1:8080/"
names = {"a": "  read: bitmap", "b": "  read: relocate", "c": "  read: globals", "d": "  read: page, arena, parts", "e": "  build: copy", "f": "  build: walk", "l": "relayout", "m": "page shown", "n": "parse", "o": "CSS", "p": "layout",
         "q": "page file read", "r": "page file built", "s": "  selectors matched",
         "t": "  declarations"}


def go(a, path):
    a.key("ctrl+l")
    a.type("127.0.0.1:8080/" + path)
    a.key("Return")


def count(prefix):
    return len([l for l in open(log).read().split("\n") if l.startswith(prefix)])


try:
    a = Amiga()
    wait_log(log, "page " + U + "index.html", timeout=120)
    time.sleep(2)
    for what, path in (("fetched", "big.html"), ("from the disk cache", "big.html"),
                       ("coming in 4 parts", "bigslow")):
        n = count("page " + U + path + " ")
        go(a, path)
        wait_log(log, "page " + U + path, n + 1, timeout=600)
        time.sleep(3)
        n = count("page " + U + "index.html ")
        go(a, "index.html")
        wait_log(log, "page " + U + "index.html", n + 1, timeout=600)
        text = open(log).read().split("\n")
        i = [k for k, l in enumerate(text) if l.startswith("go " + U + path)][-1]
        j = [k for k, l in enumerate(text) if l.startswith("go " + U + "index.html")][-1]
        out.write("%s %s:\n" % (path, what))
        for l in text[i:j]:
            if l.startswith("prof"):
                out.write("  %-18s %6s ms\n" % (names.get(l[4], l[4]), l.split()[1]))
        time.sleep(2)
    # Back: the page kept (bigslow, all there by now) shown again
    a.key("BackSpace")
    wait_log(log, "restored " + U + "bigslow", timeout=120)
    time.sleep(2)
    text = open(log).read().split("\n")
    i = [k for k, l in enumerate(text) if l.startswith("restored ")][-1]
    out.write("bigslow kept, Back:\n")
    for l in text[i - 4:i + 6]:
        if l.startswith("prof"):
            out.write("  %-18s %6s ms\n" % (names.get(l[4], l[4]), l.split()[1]))
    time.sleep(2)
    a.key("ctrl+q")
    out.write("ok\n")
except Exception as e:
    out.write("FAIL %r\n" % e)
    try:
        Amiga().key("ctrl+q")
    except Exception:
        pass
