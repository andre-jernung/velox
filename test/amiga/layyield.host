#!/usr/bin/env python3
"""Host side of layyield.script: /hugepage takes seconds to lay out;
keys pressed meanwhile are answered within a second; Esc during its
layout keeps the page; a page asked for during the layout of another
comes at once."""
import os
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
from xdrive import Amiga, wait_log  # noqa: E402

r = sys.argv[1]
log = os.path.join(r, "layyield.log")
out = open(os.path.join(r, "layyield.driver"), "w")
U = "http://127.0.0.1:8080/"
H = "hugepage?3200&%d" % int(time.time())   # (not in the disk cache yet)


def step(msg):
    out.write(msg + "\n")
    out.flush()


def lines():
    return open(log, "rb").read().decode("latin-1").split("\n")


def go(a, path):
    a.key("ctrl+l"); a.key("amiga+x")
    a.type("127.0.0.1:8080/" + path)
    a.key("Return")


def keys_until(a, done, most=120):
    """Press Down every 0.3 s until done(lines) holds; the answer time of
    each (its "key 77" line); Out: (seconds it took, worst answer)."""
    t0 = time.time()
    worst = 0
    while not done(lines()):
        if time.time() - t0 > most:
            raise AssertionError("not done after %d s" % most)
        n = lines().count("key 77")
        t = time.time()
        a.key("Down")
        while lines().count("key 77") <= n and time.time() - t < 10:
            time.sleep(0.02)
        worst = max(worst, time.time() - t)
        time.sleep(0.3)
    return time.time() - t0, worst


try:
    a = Amiga()
    wait_log(log, "page " + U + "index.html")
    time.sleep(1)
    if os.environ.get("LAYPROBE"):
        for n in [int(x) for x in os.environ["LAYPROBE"].split(",")]:
            t = time.time()
            go(a, "hugepage?%d" % n)
            wait_log(log, "page " + U + "hugepage?%d" % n, timeout=300)
            step("probe %d rows: %.1f s" % (n, time.time() - t))
            time.sleep(1)
    # 1. keys are answered while the page is laid out
    go(a, H)
    wait_log(log, "go " + U + H)
    took, worst = keys_until(a, lambda l: any(x.startswith("page " + U + H) for x in l))
    step("hugepage shown after %.1f s" % took)
    if took < 2:
        raise AssertionError("laid out too fast to tell (%.1f s): make it bigger" % took)
    if worst > 1.0:
        raise AssertionError("a key waited %.1f s" % worst)
    step("keys answered while it was laid out")
    time.sleep(1)
    # 2. Back while the page is laid out (from the disk cache now: one
    # layout): the page before comes at once
    def count(prefix):
        return len([x for x in lines() if x.startswith(prefix)])

    def go_lay(path):
        """go to path; Out: when its (first) layout began"""
        # its HTML from the disk cache, not its page file (laid out)
        cache = os.path.join(os.path.dirname(r), "Cache")
        for f in os.listdir(cache):
            if f.endswith((".p", ".p.uaem")):
                os.remove(os.path.join(cache, f))
        n = count("layout ")
        g = count("go ")
        go(a, path)
        wait_log(log, "go ", g + 1)
        wait_log(log, "layout ", n + 1, timeout=60)
        return time.time()

    k = count("page " + U + "index.html")
    a.key("BackSpace")
    wait_log(log, "page " + U + "index.html", k + 1, timeout=30)
    time.sleep(1)
    # (to second.html: Back goes from the page shown until the new one is
    # shown, and the history is index.html, second.html now)
    go(a, "second.html")
    wait_log(log, "page " + U + "second.html", timeout=30)
    time.sleep(1)
    h = count("page " + U + H)
    go_lay(H)
    t = time.time()
    k = count("page " + U + "index.html")
    a.key("BackSpace")
    wait_log(log, "page " + U + "index.html", k + 1, timeout=30)
    dt = time.time() - t
    if count("page " + U + H) > h:
        raise AssertionError("the page left was finished first")
    if dt > 1.5:
        raise AssertionError("Back took %.1f s" % dt)
    step("Back while a page was laid out: at once (%.1f s)" % dt)
    time.sleep(1)
    # 3. Esc while the page is laid out: it is finished and stays
    go_lay(H)
    a.key("Escape")
    wait_log(log, "page " + U + H, h + 1, timeout=60)
    time.sleep(1)
    n = lines().count("key 77")
    a.key("Down")
    wait_log(log, "key 77", n + 1, timeout=10)
    if not lines()[-3:] or not any(x.startswith("scroll ") for x in lines()[-6:]):
        raise AssertionError("the page does not scroll")
    step("Esc while laid out: finished, the page stays")
    a.key("ctrl+q")
    step("ok")
except Exception as e:
    step("FAIL " + repr(e))
    try:
        Amiga().key("ctrl+q")
    except Exception:
        pass
