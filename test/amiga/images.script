; images: PNG, GIF, JPEG through datatypes (test/amiga/images.host);
; no memory may be lost (bitmaps, datatype objects)
Echo >VELOX:r/images.txt "images"
Run >NIL: VELOX:velox http://127.0.0.1:8080/images.html
Wait 8
Status >ENV:vpid COMMAND=VELOX:velox
Break $vpid C
Wait 2
Delete >NIL: ENV:vpid
Avail >NIL: FLUSH
Echo >>VELOX:r/images.txt "mem_before " NOLINE
Avail >>VELOX:r/images.txt TOTAL
Echo >VELOX:r/images.start ""
VELOX:velox http://127.0.0.1:8080/images.html LOG=VELOX:r/images.log
Echo >>VELOX:r/images.txt "exit rc=$RC"
Avail >NIL: FLUSH
Echo >>VELOX:r/images.txt "mem_after " NOLINE
Avail >>VELOX:r/images.txt TOTAL
Echo >>VELOX:r/images.txt "done"
