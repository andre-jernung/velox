#!/usr/bin/env python3
"""Host side of typeahead.script: Ctrl-L and an address typed while a
slow page loads are not lost: the window works while it loads, and the
new address stops the slow page and is opened at once."""
import os
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
from xdrive import Amiga, wait_log  # noqa: E402

r = sys.argv[1]
log = os.path.join(r, "typeahead.log")
out = open(os.path.join(r, "typeahead.driver"), "w")
U = "http://127.0.0.1:8080/"


def step(msg):
    out.write(msg + "\n")
    out.flush()


try:
    a = Amiga()
    wait_log(log, "page " + U + "index.html")
    time.sleep(1)
    a.key("ctrl+l")
    a.type("127.0.0.1:8080/slowpage")
    a.key("Return")
    wait_log(log, "go " + U + "slowpage")
    time.sleep(0.5)
    a.key("ctrl+l")                 # while the slow page loads
    a.type("127.0.0.1:8080/third.html")
    a.key("Return")
    t0 = time.time()
    lines = wait_log(log, "page " + U + "third.html", timeout=30)
    took = time.time() - t0
    if "stopped " + U + "slowpage" not in lines:
        raise AssertionError("the slow page was not stopped")
    if any(l.startswith("page " + U + "slowpage ") for l in lines):
        raise AssertionError("the slow page was shown")
    if took > 5:
        raise AssertionError("the new address took %.1f s" % took)
    step("the address typed meanwhile stopped the slow page and opened at once")
    a.key("ctrl+q")
    step("ok")
except Exception as e:
    step("FAIL " + repr(e))
    try:
        Amiga().key("ctrl+q")
    except Exception:
        pass
