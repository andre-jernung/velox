#!/bin/sh
# icon for wb.script: Velox started from Workbench, settings as tool types
d="$(dirname "$0")/../.."
exec python3 "$d/tools/mkicon.py" "$d/gfx/icon-mwb.png" "$1/velox.info" \
	"LOG=VELOX:r/wb.log" \
	"URL=http://127.0.0.1:8080/second.html" \
	"HOME=http://127.0.0.1:8080/third.html" \
	"(PROXY=1.2.3.4:5)" \
	"PUBSCREEN=NoSuchScreen"
